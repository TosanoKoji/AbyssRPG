<svg xmlns="http://www.w3.org/2000/svg" width="520" height="240">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#0a0a12"/>
      <stop offset="60%" stop-color="#1a1018"/>
      <stop offset="100%" stop-color="#2a1f1a"/>
    </linearGradient>
    <pattern id="stones" x="0" y="0" width="40" height="30" patternUnits="userSpaceOnUse">
      <rect width="40" height="30" fill="#1a1a20"/>
      <rect x="1" y="1" width="18" height="13" rx="1" fill="#222228" stroke="#0d0d10" stroke-width="0.5"/>
      <rect x="21" y="1" width="18" height="13" rx="1" fill="#1f1f25" stroke="#0d0d10" stroke-width="0.5"/>
      <rect x="1" y="16" width="38" height="13" rx="1" fill="#21212a" stroke="#0d0d10" stroke-width="0.5"/>
    </pattern>
  </defs>
  <!-- 背景 -->
  <rect width="520" height="240" fill="url(#sky)"/>
  <!-- 石畳 下部 -->
  <rect y="150" width="520" height="90" fill="url(#stones)" opacity="0.9"/>
  <!-- 霧エフェクト -->
  <rect width="520" height="240" fill="url(#sky)" opacity="0.3"/>
  <!-- 左の柱 -->
  <rect x="20" y="20" width="18" height="220" rx="4" fill="#1c1c22" stroke="#2a2a35" stroke-width="1"/>
  <rect x="20" y="20" width="18" height="12" rx="2" fill="#2a2a38"/>
  <!-- 右の柱 -->
  <rect x="482" y="20" width="18" height="220" rx="4" fill="#1c1c22" stroke="#2a2a35" stroke-width="1"/>
  <rect x="482" y="20" width="18" height="12" rx="2" fill="#2a2a38"/>
  <!-- 松明 左 -->
  <rect x="32" y="55" width="6" height="20" rx="2" fill="#5a3a10"/>
  <ellipse cx="35" cy="52" rx="6" ry="10" fill="#ff6a00" opacity="0.85"/>
  <ellipse cx="35" cy="48" rx="4" ry="7" fill="#ffcc00" opacity="0.7"/>
  <!-- 松明 右 -->
  <rect x="482" y="55" width="6" height="20" rx="2" fill="#5a3a10"/>
  <ellipse cx="485" cy="52" rx="6" ry="10" fill="#ff6a00" opacity="0.85"/>
  <ellipse cx="485" cy="48" rx="4" ry="7" fill="#ffcc00" opacity="0.7"/>
  <!-- 炎の光 -->
  <radialGradient id="fl" cx="35" cy="52" r="60" gradientUnits="userSpaceOnUse">
    <stop offset="0%" stop-color="#ff6a00" stop-opacity="0.18"/>
    <stop offset="100%" stop-color="#ff6a00" stop-opacity="0"/>
  </radialGradient>
  <rect width="520" height="240" fill="url(#fl)"/>
  <!-- 全体を少し暗くして重ねる -->
  <rect width="520" height="240" fill="#000" opacity="0.35"/>
</svg>
